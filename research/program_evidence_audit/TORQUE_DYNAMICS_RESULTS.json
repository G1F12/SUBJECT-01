  "transfer_boundary_assessment": {
    "krizaj_2025_src_0112": "Only 3 EQI contractions, ~98% MVIC retained, no intra-session fatigue decay kinetics",
    "jutlah_2026_src_0040": "Repeated sprint cycle work recorded at discrete bouts, no continuous intra-sprint torque profile bins",
    "norbury_2020_src_0111": "Discrete set volume (kg*reps) with 5-45-24h post measurements, no intra-set continuous dynamometry",
    "conclusion": "N=9 in Evangelidis et al. represents the definitive open-data transfer boundary for sequential contraction dynamics. While tau_end nominally achieves DeltaMAE = +1.022 Nm over MeanRetention, its 95% bootstrap CI [-3.807, +6.608] Nm widely spans zero due to high inter-subject variance on N=9, failing the pre-specified utility criterion."
  },
  "scientific_conclusion": {
    "r_late_adds_signal": false,
    "s_tau_adds_signal": false,
    "tau_end_nominal_improvement": true,
    "tau_end_statistically_significant": false,
    "adding_work_to_tau_end_improves": false,
    "epistemic_decision": "Sequential torque dynamics confirm that relative decay slopes (R_late, S_tau) fail to predict post-exercise force. Terminal torque (tau_end) nominally improves MAE to 10.22 Nm (+1.02 Nm vs MeanRetention, +4.04 Nm vs Pre+Cond), but fails the pre-specified statistical significance criterion (95% CI [-3.81, +6.61] Nm spans zero). Crucially, adding work in Joules to tau_end degrades MAE by +1.62 Nm (11.85 Nm vs 10.22 Nm), confirming that cumulative work introduces destructive noise. Architecture A remains at CONDITIONAL_POTENTIAL_WHOLE_SYSTEM_HOLD."
  }
